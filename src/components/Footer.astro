---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath } from '../i18n';
import EmailLink from './EmailLink.astro';
import SocialLinks from './SocialLinks.astro';
import logo from '../assets/logo-small.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const legatura =
  'inline-flex min-h-11 items-center text-brand-200 underline decoration-brand-700 underline-offset-2 hover:text-white';
---

<!-- Subsol compact: un singur rând pe ecran lat, trei rânduri scurte pe telefon. -->
<footer class="mt-0 bg-brand-950 text-stone-300">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:justify-between">
    <a href={localePath(lang, '/')} class="flex min-h-11 items-center gap-3">
      <Image src={logo} alt="" width="80" height="80" format="webp" class="h-10 w-10 rounded-full" loading="lazy" />
      <span class="font-serif text-lg font-bold text-white">{t('site.name')}</span>
    </a>

    <SocialLinks
      showGroups={false}
      class="-ml-2 flex-wrap gap-1 md:ml-0 [&_a]:text-stone-400 [&_a:hover]:bg-brand-800 [&_a:hover]:text-white"
    />

    <ul class="flex flex-wrap gap-x-6 text-sm">
      <li><EmailLink class={legatura} /></li>
      <li>
        <a href={localePath(lang, '/newsletter/')} class={legatura}>{t('contact.newsletterLink')}</a>
      </li>
    </ul>
  </div>

  <p class="border-t border-brand-900 px-4 py-3 text-center text-xs text-stone-400">
    © {year} Nepsis Elvetia. {t('footer.rights')}
  </p>
</footer>
