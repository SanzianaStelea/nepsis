---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { type Locale, formatDate, useTranslations } from '../i18n';
import { thumbSrcset, thumbUrl } from '../lib/images';
import FallbackBadge from './FallbackBadge.astro';
import sigla from '../assets/sigla-nepsis.png';

/**
 * O amintire în arhivă: fotografia întâi, apoi data și locul, titlul, două
 * rânduri de rezumat și legătura spre pagina proprie. Fără chenar și fără umbră.
 *
 * Fotografia e decupată la 4:3 ca grila să iasă egală; încadrarea e ținută puțin
 * peste centru (42%), unde stau de obicei chipurile în pozele de grup.
 */
interface Props {
  memory: CollectionEntry<'amintiri'>;
  lang: Locale;
  /** Link către pagina proprie a amintirii. */
  href: string;
  /** Primele rânduri din text, deja curățate de marcaje. */
  rezumat: string;
  /** `true` când amintirea nu e tradusă și se afișează în română. */
  fallback?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { memory, lang, href, rezumat, fallback = false, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const cover = memory.data.images[0];
const { date, showDate, location, title } = memory.data;
---

<article class="flex flex-col" lang={fallback ? 'ro' : undefined}>
  {
    cover ? (
      <img
        src={thumbUrl(cover.src, 480)}
        srcset={thumbSrcset(cover.src, [480, 960])}
        sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw"
        width="480"
        height="360"
        alt={cover.alt}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full rounded-lg bg-stone-100 object-cover object-[50%_42%]"
      />
    ) : (
      <div aria-hidden="true" class="flex aspect-[4/3] w-full items-center justify-center rounded-lg bg-brand-50">
        <Image src={sigla} alt="" height={96} format="webp" loading="lazy" class="h-12 w-auto opacity-60 mix-blend-multiply" />
      </div>
    )
  }
  {
    ((date && showDate) || location) && (
      <p class="mt-3 text-sm text-stone-600">
        {date && showDate && (
          <time datetime={date.toISOString().slice(0, 10)} lang={lang}>
            {formatDate(date, lang)}
          </time>
        )}
        {date && showDate && location && ' · '}
        {location}
      </p>
    )
  }
  {fallback && <FallbackBadge lang={lang} class="mt-2 self-start" />}
  <Heading class="mt-1 font-serif text-xl font-semibold leading-snug text-brand-900">
    <a href={href} class="decoration-brand-300 underline-offset-4 hover:underline">{title}</a>
  </Heading>
  <p class="mt-2 line-clamp-2 text-stone-700">{rezumat}</p>
  <a class="link-text mt-1 gap-1 self-start" href={href} lang={lang}>
    {t('memories.readMore')}<span class="sr-only" lang={fallback ? 'ro' : undefined}>: {title}</span><span aria-hidden="true">→</span>
  </a>
</article>
