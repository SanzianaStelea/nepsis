---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('despre', lang);
---

<Base lang={lang} title={`${t('nav.whoWeAre')} · ${t('site.name')}`} description={entry.data.description ?? t('site.description')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{entry.data.title}</h1>
    {/*
      Intervalul de vârstă e informația pe care o caută cineva care se întreabă
      dacă frăția i se adresează — de aceea stă separat, deasupra textului.
    */}
    <p class="mt-4 text-lg font-semibold text-brand-800">{t('home.ageRange')}</p>
    <div class="prose-md mt-6 text-stone-700">
      <Content />
    </div>
    <p class="mt-8 flex flex-wrap gap-x-6">
      <a href={localePath(lang, '/ocrotitorul/')} class="link-text">{t('nav.patron')}</a>
      <a href={localePath(lang, '/echipa/')} class="link-text">{t('nav.members')}</a>
    </p>
    <p class="mt-6">
      <a href={localePath(lang, '/devino-membru/')} class="btn btn-primary">{t('nav.join')}</a>
    </p>
  </div>
</Base>
