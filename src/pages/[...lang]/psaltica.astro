---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations, type UIKey } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
const { entry: materiale, Content: Materiale } = await getPage('psaltica-materiale', lang);

const program = (['when', 'where', 'duration', 'who'] as const).map((k) => ({
  label: t(`psaltica.${k}.label` as UIKey),
  value: t(`psaltica.${k}` as UIKey),
}));
const titlu = 'text-2xl font-bold text-brand-950';
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('psaltica.title')}</h1>

    <div class="mt-6 grid gap-8 md:grid-cols-[1fr_14rem] md:items-start">
      <div class="prose-md max-w-prose text-lg text-stone-700">
        <Content />
      </div>
      <Image
        src={psalticaLogo}
        alt={t('psaltica.logoAlt')}
        widths={[160, 320, 448]}
        sizes="(min-width: 768px) 14rem, 10rem"
        format="webp"
        quality={70}
        fetchpriority="high"
        decoding="async"
        class="w-40 rounded-lg md:w-56"
      />
    </div>

    <section class="mt-12" aria-labelledby="program">
      <h2 id="program" class={titlu}>{t('psaltica.scheduleTitle')}</h2>
      <dl class="mt-4 grid gap-x-8 gap-y-4 border-y border-stone-200 py-6 sm:grid-cols-2">
        {
          program.map((p) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-brand-700">{p.label}</dt>
              <dd class="mt-1 text-stone-800">{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="participa">
      <h2 id="participa" class={titlu}>{t('psaltica.joinTitle')}</h2>
      <p class="mt-3 max-w-prose text-stone-700">{t('psaltica.joinText')}</p>
      <a class="btn btn-primary mt-4" href="mailto:nepsis.ch@mitropolia.eu">{t('join.cta')}</a>
    </section>

    <section class="mt-12" aria-labelledby="materiale">
      <h2 id="materiale" class={titlu}>{materiale.data.title}</h2>
      <div class="prose-md mt-4 text-stone-700">
        <Materiale />
      </div>
    </section>

    <!-- Arhiva mărturiilor din 2020 (hartă ArcGIS), doar ca legătură externă. -->
    <section class="mt-12 border-t border-stone-200 pt-8" aria-labelledby="arhiva">
      <h2 id="arhiva" class="text-xl font-bold text-brand-950">{t('psaltica.testimonials')}</h2>
      <p class="mt-2 max-w-prose text-stone-600">{t('psaltica.archiveText')}</p>
      <a
        class="btn btn-secondary mt-4"
        href="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f"
        target="_blank"
        rel="noopener"
      >
        {t('psaltica.archiveLink')}<span class="sr-only"> {t('common.newTab')}</span>
      </a>
    </section>
  </div>
</Base>
