---
import Base from '../../layouts/Base.astro';
import EmailLink from '../../components/EmailLink.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t('contact.title')} · ${t('site.name')}`} description={t('contact.description')}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <!--
      Titlul paginii și fraza de întâmpinare au fost scoase la cererea
      utilizatorului. „Scrie-ne” urcă în locul lor ca h1: pagina trebuie să
      păstreze un titlu de nivel întâi pentru cititoarele de ecran și pentru
      indexare, iar numele rubricii rămâne în <title>.
    -->
    <div class="grid gap-6 md:grid-cols-2">
      <section class="rounded-xl border border-brand-200 bg-white p-6 sm:p-8" aria-labelledby="contact-email">
        <h1 id="contact-email" class="text-xl font-semibold text-brand-900">{t('contact.writeUs')}</h1>
        <p class="mt-3 text-stone-700">
          {t('contact.emailIntro')}
          <br />
          <EmailLink class="text-lg font-semibold text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900" />
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="mailto:nepsis.ch@mitropolia.eu" class="btn btn-primary">
            {t('contact.emailButton')}
          </a>
          <a
            href={localePath(lang, '/newsletter/')}
            class="btn btn-secondary"
          >
            {t('contact.newsletterButton')}
          </a>
        </div>
      </section>

      <section class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8" aria-labelledby="contact-social">
        <h2 id="contact-social" class="text-xl font-semibold text-brand-900">{t('contact.social')}</h2>
        <p class="mt-3 text-stone-700">{t('contact.groupsText')}</p>
        <SocialLinks class="mt-5 -ml-2 flex-wrap" />
      </section>
    </div>

    <!-- Invitație: devino membru -->
    <section
      class="mt-6 flex flex-col items-center gap-4 on-dark rounded-xl bg-brand-800 p-8 text-center text-white sm:flex-row sm:justify-between sm:text-left"
      aria-labelledby="contact-membru"
    >
      <div>
        <h2 id="contact-membru" class="font-serif text-2xl font-bold">{t('contact.joinTitle')}</h2>
        <p class="mt-1 text-brand-100">{t('contact.joinText')}</p>
      </div>
      <a
        href={localePath(lang, '/devino-membru/')}
        class="btn btn-on-dark shrink-0"
      >
        {t('contact.joinLink')} →
      </a>
    </section>

    <!-- Informații secundare -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <section class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8" aria-labelledby="contact-banca">
        <h2 id="contact-banca" class="text-xl font-semibold text-brand-900">{t('contact.bank')}</h2>
        <dl class="mt-4 space-y-2 text-stone-700">
          <div>
            <dt class="inline font-semibold">IBAN:</dt>
            <dd class="inline">CH95 0900 0000 1545 2680 8</dd>
          </div>
          <div>
            <dt class="inline font-semibold">BIC:</dt>
            <dd class="inline">POFICHBEXXX</dd>
          </div>
          <div>
            <dt class="inline font-semibold">{t('contact.bank.holder')}:</dt>
            <dd class="inline">Nepsis Elvetia</dd>
          </div>
        </dl>
      </section>

      <section class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8" aria-labelledby="contact-utile">
        <h2 id="contact-utile" class="text-xl font-semibold text-brand-900">{t('contact.useful')}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-stone-700">
          <li>
            <a href="http://www.mitropolia.eu/ro/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.mitropolia')}
            </a>
          </li>
          <li>
            <a href="http://www.nepsis.org/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.nepsis')}
            </a>
          </li>
          <li>
            <a href="http://www.mitropolia.eu/ro/site/172/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.parohii')}
            </a>
          </li>
          <li>
            <a href="http://monasteresuisse.mitropolia.eu/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.manastire')}
            </a>
          </li>
        </ul>
      </section>
    </div>

  </div>
</Base>
