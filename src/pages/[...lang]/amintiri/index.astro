---
import Base from '../../../layouts/Base.astro';
import MemoryCard from '../../../components/MemoryCard.astro';
import MemoriesTabs from '../../../components/MemoriesTabs.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, defaultLocale } from '../../../i18n';
import { getMemoriesByYear, rezumatText, warnMissingContent } from '../../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii.
const years = await getMemoriesByYear(lang);
// Lista de lucru (text/poze lipsă) apare în consola build-ului.
await warnMissingContent();
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('memories.title')}</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600">{t('memories.intro')}</p>
    {lang !== defaultLocale && <p class="mt-2 text-sm italic text-stone-500">{t('memories.onlyRo')}</p>}

    <MemoriesTabs lang={lang} current="events" />

    <!-- Cuprins pe ani -->
    <nav aria-label={t('memories.year')} class="mt-6 flex flex-wrap gap-2">
      {
        years.map(({ year }) => (
          <a
            href={`#an${year}`}
            class="inline-flex min-h-11 items-center rounded-full border border-brand-200 px-4 text-sm font-semibold text-brand-800 hover:bg-brand-50"
          >
            {year}
          </a>
        ))
      }
    </nav>

    <div class="mt-12 space-y-16">
      {
        years.map(({ year, entries }) => (
          <section aria-labelledby={`an${year}`}>
            <h2 id={`an${year}`} class="scroll-mt-24 border-b border-stone-200 pb-2 text-2xl font-bold text-brand-950 sm:text-3xl">
              {t('memories.year')} {year}
            </h2>
            <div class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {entries.map(({ memory, slug, fallback }) => (
                <MemoryCard
                  memory={memory}
                  lang={lang}
                  href={localePath(lang, `/amintiri/${slug}/`)}
                  rezumat={rezumatText(memory.body, 180)}
                  fallback={fallback}
                  headingLevel="h3"
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
